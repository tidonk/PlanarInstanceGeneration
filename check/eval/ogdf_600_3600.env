# OGDF rerun. The build and source screening must complete before generation.
PIG_EXPERIMENT=ogdf_20261104
PIG_INSTANCES=100
PIG_BASE_SEED=0
PIG_METHODS="random high_degree kamada_kawai heuristic_outer_face exact_outer_face"
PIG_OUTER_FACE_SAMPLING=consecutive
PIG_OUTER_FACE_PREFER_NON_LEAF=0
PIG_PGLIB_GENERATE_ARGS="--source-pool check/results/pglib_source_pool_innoptem/manifest.json --num-subinstances 2 5 --min-source-nodes 73 --target-size 100 1000 --size-range 0.15 0.85 --max-attempts 25 --exact-time-limit 600 --outer-face-sampling consecutive --threads 16 --opf-threads 1 --opf-time-limit 300"
PIG_SND_GENERATE_ARGS="--num-subinstances 2 5 --size-range 0.15 0.85 --max-attempts 25 --exact-time-limit 600 --outer-face-sampling consecutive --threads 16 --application-threads 1"
PIG_POSTPROCESS_ARGS="--no-compile --threads 16 --skewness-workers 1 --skewness-time-limit 3600 --betweenness-samples 0"
PIG_APPLICATION_TIME_LIMIT=10800
PIG_TOPOLOGICAL_ACTION_LIMIT=1
PIG_SCOPF_WARMSTART=1
PIG_SCOPF_WARMSTART_TIME_LIMIT=10800
PIG_SCOTS_BENDERS_SETTINGS="${REPO_ROOT}/check/eval/scots_benders.toml"
PIG_APPLICATION_THREADS=1
PIG_SCOPF_REPOSITORY="${REPO_ROOT}/build/TopologyOptimizer"
export PIG_OPF_REPOSITORY="${REPO_ROOT}/build/TopologyOptimizer"
export PIG_OPF_JULIA_DEPOT="/local/tmp/$(id -un)/.julia-pig-installed"
export PIG_SCOPF_JULIA_DEPOT="$PIG_OPF_JULIA_DEPOT"
export PIG_JULIA="${PIG_JULIA:-julia}"
source "$(dirname "${BASH_SOURCE[0]}")/settings.env"
