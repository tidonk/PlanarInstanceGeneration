# Sampling alternatives use the main solver and source settings.
PIG_SELECTED_SAMPLING="${PIG_OUTER_FACE_SAMPLING:-consecutive}"
PIG_SELECTED_NON_LEAF="${PIG_OUTER_FACE_PREFER_NON_LEAF:-0}"
source "$(dirname "${BASH_SOURCE[0]}")/ogdf_600_3600.env"
PIG_OUTER_FACE_SAMPLING="$PIG_SELECTED_SAMPLING"
PIG_OUTER_FACE_PREFER_NON_LEAF="$PIG_SELECTED_NON_LEAF"
PIG_PGLIB_GENERATE_ARGS="--source-pool check/results/pglib_source_pool_innoptem/manifest.json --num-subinstances 2 5 --min-source-nodes 73 --target-size 100 1000 --size-range 0.15 0.85 --max-attempts 25 --exact-time-limit 600 --outer-face-sampling ${PIG_OUTER_FACE_SAMPLING} --threads 16 --opf-threads 1 --opf-time-limit 300"
# These supplementary application checks are SCOPF, with switching disabled.
PIG_APPLICATION_TIME_LIMIT=300
PIG_TOPOLOGICAL_ACTION_LIMIT=0
PIG_SCOPF_WARMSTART=0
