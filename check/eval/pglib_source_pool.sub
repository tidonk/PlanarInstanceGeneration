# Merge all completed source results before releasing PGLib generation.
universe = vanilla
executable = .venv/bin/python
arguments = check/eval/merge_pglib_source_pools.py $(source_jobs)
priority = $(job_priority:50)
should_transfer_files = NO
getenv = PATH, HOME, USER, LOGNAME, LANG, LC_ALL
+FileSystemDomain = "clustor"
request_cpus = 1
request_memory = 14336
request_disk = 2097152
+MaxRuntime = 3600
on_exit_hold = (ExitCode =!= 0)
output = check/eval/logs/$(experiment)/pglib/source_pool.out
error = check/eval/logs/$(experiment)/pglib/source_pool.err
log = check/eval/logs/$(experiment)/pglib/source_pool.log
queue
