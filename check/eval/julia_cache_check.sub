universe = vanilla
executable = check/eval/julia_cache_check.sh
should_transfer_files = NO
getenv = HOME, PATH, GUROBI_HOME, GRB_LICENSE_FILE
batch_name = pig-julia-local-check
nice_user = False
priority = 1000
