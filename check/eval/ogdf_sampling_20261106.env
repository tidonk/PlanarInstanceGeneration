# Only the sampling rule changes relative to OGDF OF-B generation.
PIG_REQUESTED_SAMPLING="${PIG_OUTER_FACE_SAMPLING:-consecutive}"
PIG_REQUESTED_PREFERENCE="${PIG_OUTER_FACE_PREFER_NON_LEAF:-0}"
source "$(dirname "${BASH_SOURCE[0]}")/ogdf_scopf_20261106.env"
PIG_METHODS="exact_outer_face"
PIG_OUTER_FACE_SAMPLING="$PIG_REQUESTED_SAMPLING"
PIG_OUTER_FACE_PREFER_NON_LEAF="$PIG_REQUESTED_PREFERENCE"
PIG_PGLIB_GENERATE_ARGS="${PIG_PGLIB_GENERATE_ARGS/--outer-face-sampling consecutive/--outer-face-sampling ${PIG_OUTER_FACE_SAMPLING}}"
# Unlimited application solves; generation planarization limits are unchanged.
PIG_APPLICATION_TIME_LIMIT=0
export PIG_OPF_REPOSITORY="$PIG_SCOPF_REPOSITORY"
export PIG_OPF_JULIA_DEPOT="$PIG_SCOPF_JULIA_DEPOT"
