# Canonical settings for the full HTCondor experiment.
# This file is sourced by prepare.sh, job.sh, and report.sh.

: "${PIG_EXPERIMENT:=full_shared4_300}"
: "${PIG_INSTANCES:=100}"
: "${PIG_BASE_SEED:=0}"
: "${PIG_DATASETS:=pglib snd}"
: "${PIG_METHODS:=random high_degree kamada_kawai heuristic_outer_face exact_outer_face}"
: "${PIG_OUTER_FACE_SAMPLING:=consecutive}"
: "${PIG_OUTER_FACE_PREFER_NON_LEAF:=0}"

# Dataset-specific arguments forwarded by job.sh. PGLib first filters its input
# pool to sources with at least 73 buses, then generates 100--1000-bus outputs.
# SNDlib keeps its complete input pool and derives its output interval from the
# smallest loaded source instance through 100 nodes.
: "${PIG_PGLIB_GENERATE_ARGS:=--num-subinstances 2 5 --min-source-nodes 73 --target-size 100 1000 --size-range 0.15 0.85 --max-attempts 25 --exact-time-limit 300 --outer-face-sampling ${PIG_OUTER_FACE_SAMPLING} --threads 1}"
: "${PIG_SND_GENERATE_ARGS:=--num-subinstances 2 5 --size-range 0.15 0.85 --max-attempts 25 --exact-time-limit 300 --outer-face-sampling ${PIG_OUTER_FACE_SAMPLING} --threads 1}"

# Consolidation/report settings. The report submit file requests four CPUs.
: "${PIG_POSTPROCESS_ARGS:=--threads 1 --skewness-workers 4 --skewness-time-limit 300 --betweenness-samples 0}"

# Post-generation application evaluation. These jobs consume accepted final
# composites and never participate in generation acceptance or redraw logic.
: "${PIG_JULIA:=julia}"
: "${PIG_SCOPF_REPOSITORY:=${REPO_ROOT}/build/TopologyOptimizer}"
: "${PIG_SND_BENDERS_REPOSITORY:=${REPO_ROOT}/third_party/BendersNetworkDesign}"
: "${PIG_APPLICATION_TIME_LIMIT:=10800}"
: "${PIG_APPLICATION_THREADS:=1}"
: "${PIG_TOPOLOGICAL_ACTION_LIMIT:=0}"
: "${PIG_SND_IGNORE_MANIFEST_JULIA:=1}"
# Gurobi's TimeLimit excludes some callback work performed by the external
# Benders implementation. Preserve the 10,800 s solver budget but leave enough
# wall time for callbacks to return and for Julia to serialize the result.
: "${PIG_SND_WALL_CLOCK_GRACE:=3300}"

# Shared dependencies with a writable per-node cache.
export JULIA_DEPOT_PATH="${JULIA_DEPOT_PATH:-${TMPDIR:-/tmp}/pig-julia-${UID}:${REPO_ROOT}/build/julia-depot}"
