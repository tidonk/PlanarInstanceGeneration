# Frozen scientific settings for the certificate-reuse rerun.
PIG_INSTANCES=100
PIG_BASE_SEED=0
PIG_METHODS="random high_degree kamada_kawai heuristic_outer_face exact_outer_face"
PIG_OUTER_FACE_SAMPLING=consecutive
PIG_OUTER_FACE_PREFER_NON_LEAF=0
PIG_PGLIB_GENERATE_ARGS="--num-subinstances 2 5 --min-source-nodes 73 --target-size 100 1000 --size-range 0.15 0.85 --max-attempts 25 --exact-time-limit 600 --outer-face-sampling consecutive --threads 1"
PIG_SND_GENERATE_ARGS="--num-subinstances 2 5 --size-range 0.15 0.85 --max-attempts 25 --exact-time-limit 600 --outer-face-sampling consecutive --threads 1"
PIG_POSTPROCESS_ARGS="--no-compile --threads 1 --skewness-workers 4 --skewness-time-limit 3600 --betweenness-samples 0"
PIG_APPLICATION_TIME_LIMIT=300
PIG_APPLICATION_THREADS=1
source "$(dirname "${BASH_SOURCE[0]}")/settings.env"
